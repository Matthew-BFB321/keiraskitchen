        {
          "id": "bb19c538-8326-4881-9285-d1b34a5fc01d",
          "position": 1,
          "text": "Preheat the oven to 180 °C and grease a 20 × 30 cm ovenproof dish.",
          "timerSeconds": null
        },
        {
          "id": "ef34a3a9-2746-4d33-a210-5531bbb69155",
          "position": 2,
          "text": "Soak the bread in 125 ml of the milk while you start the mince.",
          "timerSeconds": null
        },
        {
          "id": "d0fe3707-be10-45fd-a316-70620ab30892",
          "position": 3,
          "text": "Heat the oil in a large pan and fry the onions until soft and golden.",
          "timerSeconds": 480
        },
        {
          "id": "3782f0ec-9bb3-4c1e-9699-1310ccfa7d31",
          "position": 4,
          "text": "Add the garlic, curry powder and turmeric and fry for 1 minute until fragrant.",
          "timerSeconds": 60
        },
        {
          "id": "5130db5e-c0ac-40f0-b72c-df7c62e1544c",
          "position": 5,
          "text": "Add the mince and brown it, breaking it up with a wooden spoon.",
          "timerSeconds": 600
        },
        {
          "id": "bf4cea34-85d1-4590-8a9e-2aa24043c255",
          "position": 6,
          "text": "Squeeze the milk out of the bread (keep the milk) and mash the bread into the mince with the chutney, jam, sultanas, lemon juice and salt.",
          "timerSeconds": null
        },
        {
          "id": "60451cc7-f4c1-4bdc-bf58-db92d327f05c",
          "position": 7,
          "text": "Spoon the mince into the dish and level the top.",
          "timerSeconds": null
        },
        {
          "id": "11b7e8d6-ca5a-4ace-8f8d-7ee3a615c796",
          "position": 8,
          "text": "Whisk the eggs with the remaining 250 ml milk plus the squeezed-out milk. Pour over the mince and tuck the bay leaves into the top.",
          "timerSeconds": null
        },
        {
          "id": "9c623aee-23a6-4e86-9103-6cbc633d0bff",
          "position": 9,
          "text": "Bake until the custard is set and golden.",
          "timerSeconds": 2100
        }
      ]
